# Ports
STRAPI_PORT=1337
FRONTEND_PORT=4200

# CORS allowed front-end origin(s)
CORS_ORIGIN=http://localhost:4200

# Optional Strapi security overrides (if left empty, backend/docker-entrypoint.sh
# generates ephemeral local-dev keys inside the container volume at runtime)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
